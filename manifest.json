{
    "manifest_version": 3,
    "name": "Owlock",
    "version": "1.0",
    "description": "Simple YouTube shorts blocker using CSS",
    "content_scripts": [
        {
            "matches": [
                "*://youtube.com/*",
                "*://www.youtube.com/*"
            ],
            "css": ["style.css"],
            "run_at": "document_start"
        }
    ]
}