
{
  "manifest_version": 3,
  "name": "owlet",
  "version": "1.2",
  "description": "A calmer way to watch.",

  "permissions": ["storage"],

  "action": {
    "default_popup": "src/html/settings-popup.html",
    "default_icon": {
      "48": "icons/owlet-48.png",
      "96": "icons/owlet-96.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/css/global.css"
      ],
      "js": [
        "src/js/settings-loader.js",
        "src/js/home.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "src/css/home.css",
        "src/css/shorts.css",
        "src/css/navigation.css",
        "src/css/view-layout.css",
        "src/html/home.html",
        "icons/owlet-96.png"
      ],
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}
