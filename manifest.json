
{
  "manifest_version": 3,
  "name": "owlet",
  "version": "1.2",
  "description": "A calmer way to watch.",
  "icons": {
    "48": "icons/owlet-48.png",
    "96": "icons/owlet-96.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/owlet-48.png",
      "96": "icons/owlet-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*"
      ],
      
      "css": [
        "src/css/global.css",
        "src/css/shorts.css",
        "src/css/view-layout.css",
        "src/css/navigation.css",
        "src/css/home.css"
      ],

      "js": [
        "src/js/home.js"
      ],

      "run_at": "document_idle"
    }
  ],

    "web_accessible_resources": [{
      "resources": [
        "src/html/home.html",
        "icons/owlet-96.png"
      ],
      "matches": ["https://www.youtube.com/*"]
  }]
}
